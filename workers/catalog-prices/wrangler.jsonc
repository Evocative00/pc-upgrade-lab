{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pc-upgrade-shared-prices",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["SHARED_PRICES_API_TOKEN"]
  },
  "observability": {
    "enabled": false
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
